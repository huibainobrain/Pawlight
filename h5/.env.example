# Copy to .env.local and fill in real values. Never commit the real .env.local file.
#
# Required in every environment (see lib/config.ts) — the app throws immediately
# (dev overlay / build failure) if this is missing. There is no localhost fallback:
# local development also targets a real deployed backend by design.
# On Vercel this must be set under Project Settings > Environment Variables for
# every environment (Production/Preview/Development) that should work.
NEXT_PUBLIC_API_URL=https://pet-memory-production.up.railway.app
