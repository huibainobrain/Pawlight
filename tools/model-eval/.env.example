# Copy to .env (gitignored, never commit real keys) and fill in before running.

# --- Seedream (Volcengine Ark) ---
# Same vendor/endpoint as backend/src/scene-portraits/providers/ark-image-gen.provider.ts.
SEEDREAM_API_KEY=
SEEDREAM_MODEL_ID=doubao-seedream-4-0-250828
SEEDREAM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# --- Nano Banana (Google Gemini image generation) ---
# Model id below is a placeholder - confirm the current id in Google's docs
# before running (this space moves fast). See src/providers/nanobanana.provider.ts
# for the exact request shape this was written against and what to check.
NANOBANANA_API_KEY=
NANOBANANA_MODEL_ID=gemini-2.5-flash-image

# --- Flux (Black Forest Labs) ---
# FLUX_ENDPOINT is the path segment after https://api.bfl.ai/v1/ - e.g.
# flux-kontext-pro or flux-kontext-max. Must be a Kontext (image-editing)
# endpoint, not a text-to-image-only one, since this eval needs a reference
# photo. See src/providers/flux.provider.ts.
FLUX_API_KEY=
FLUX_ENDPOINT=flux-kontext-pro

# --- Shared ---
# Absolute path to a local copy of the scoring workbook (the one the user
# provided as "Pawlight_图片生成模型评测表_最终执行版.xlsx"). run-eval.ts reads
# scene text from its 测试用例 sheet; fill-spreadsheet.ts writes results back
# into its 单图评分 sheet. Keep this local copy out of the repo (.gitignored).
EVAL_WORKBOOK_PATH=/Users/huibai/Downloads/Pawlight_图片生成模型评测表_最终执行版.xlsx
