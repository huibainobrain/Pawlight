# Copy to .env and fill in real values. Never commit the real .env file.
#
# Required in every environment — the server refuses to start without these
# (see src/config/env.validation.ts):
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Any long random string (e.g. `openssl rand -base64 48`). There is no
# fallback — do not leave this blank.
JWT_SECRET=

# Cloudflare R2 (S3-compatible object storage) for photo uploads. No local
# mock exists, so these are required in every environment too — without them
# uploads fail (or worse, write broken "undefined/..." URLs into the DB).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Apple Sign In / App Store Server API.
# APPLE_BUNDLE_ID must match the iOS app's Bundle ID exactly.
# APPLE_APP_APPLE_ID is the numeric App Apple ID from App Store Connect >
# App Information. Both are only required when NODE_ENV=production (local
# development can leave APPLE_APP_APPLE_ID blank and Sandbox-only purchase
# verification will still work) — but production will fail to start without
# them.
APPLE_BUNDLE_ID=com.pawlight.app
APPLE_APP_APPLE_ID=

# Optional
# MUST be set to "production" on the real deployment. Railway/Nixpacks does
# NOT set this automatically — go to the service's Variables tab and add it
# yourself. Controls whether APPLE_APP_APPLE_ID / APPLE_BUNDLE_ID are
# strictly required at startup; without it, a missing Apple var won't crash
# the server, it'll just silently leave Production purchase verification
# disabled (see purchases.service.ts).
NODE_ENV=development
PORT=3000
# Enables POST /api/v1/auth/debug-login for local testing (Debug builds only send this header).
# Leave unset in production — the endpoint refuses requests when this is empty.
DEBUG_SECRET=
