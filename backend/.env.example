# Copy to .env and fill in real values. Never commit the real .env file.
#
# Required in every environment — the server refuses to start without these
# (see src/config/env.validation.ts):
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Any long random string (e.g. `openssl rand -base64 48`). There is no
# fallback — do not leave this blank.
JWT_SECRET=

# Cloudflare R2 (S3-compatible object storage) for photo uploads. No local
# mock exists, so these are required in every environment too — without them
# uploads fail (or worse, write broken "undefined/..." URLs into the DB).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Apple Sign In / App Store Server API. Both are only required when
# NODE_ENV=production (local development can leave APPLE_APP_APPLE_ID blank
# and Sandbox-only purchase verification will still work) — but production
# will fail to start without them, and will also fail to start if either is
# present but wrong (do not put real values in this .env.example file):
#   APPLE_APP_APPLE_ID must be the numeric App Apple ID from App Store
#     Connect > App Information (a positive integer — not the Team ID or SKU).
#   APPLE_BUNDLE_ID must be exactly com.pawlight.app.
APPLE_BUNDLE_ID=com.pawlight.app
APPLE_APP_APPLE_ID=

# Optional
# MUST be set to "production" on the real deployment. Railway/Nixpacks does
# NOT set this automatically — go to the service's Variables tab and add it
# yourself. Controls whether APPLE_APP_APPLE_ID / APPLE_BUNDLE_ID are
# strictly required at startup; without it, a missing Apple var won't crash
# the server, it'll just silently leave Production purchase verification
# disabled (see purchases.service.ts).
NODE_ENV=development
PORT=3000
# Enables POST /api/v1/auth/debug-login for local testing (Debug builds only send this header).
# The iOS Debug build sends the literal string "pawlight-debug-2024" (see APIClient.swift),
# so for local dev set DEBUG_SECRET to exactly that. Leave unset in production — the
# endpoint refuses every request when this is empty.
DEBUG_SECRET=

# --- 星球观察窗场景画像/视频生成（付费功能） ---
# Volcengine Ark (火山方舟) 统一 API key，图片生成和图生视频两个接口共用。
# 留空也能正常启动服务；真实调用时才会因为空 key 让任务失败（errorCode:
# PROVIDER_NOT_CONFIGURED），不会导致进程崩溃或挂起。
ARK_API_KEY=
# 以下模型 id / base url 已在 Pawlight 的真实生成链路中用真实 ARK_API_KEY 验证通过；
# 迁移到不同模型版本或 Volcengine 一侧发生变更时，需要重新跑一遍
# `npm run smoke:scene:ark`（见 docs/reference/testing.md）后再改这里。
ARK_IMAGE_MODEL_ID=doubao-seedream-4-0-250828
ARK_VIDEO_MODEL_ID=doubao-seedance-2-0-260128
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 图片: ark | fake      视频: ark | fake
# kling 尚未实现（没有 KlingVideoGenProvider）——填未注册的值会在应用启动阶段直接报错退出，
# 不会退回到 ark，见 scene-portraits.module.ts 的 provider registry。
# "fake" = 零网络请求的测试替身，用于本地验证整条链路，见 scene-portraits/providers。
SCENE_PORTRAIT_IMAGE_PROVIDER=ark
SCENE_PORTRAIT_VIDEO_PROVIDER=ark
