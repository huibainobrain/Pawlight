generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  appleUserId String   @unique
  email       String?
  nickname    String?
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pets        Pet[]
  entitlement Entitlement?
}

model Pet {
  id               String      @id @default(cuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id])
  name             String
  type             PetType     @default(CAT)
  arrivedOn        String?
  bornOn           String?
  leftOn           String?
  mainPhotoId      String?
  story            String?
  memorialSentence String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  photos      Photo[]
  share       Share?
  letters     Letter[]
}

enum PetType {
  CAT
  DOG
  OTHER
}

// Entitlement is account-level (one per User), not per-pet.
model Entitlement {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier           Tier     @default(FREE)
  photoLimit     Int      @default(9)
  mailboxEnabled Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum Tier {
  FREE
  PAID
}

enum PhotoType {
  MAIN
  ALBUM
}

model Photo {
  id        String    @id @default(cuid())
  petId     String
  pet       Pet       @relation(fields: [petId], references: [id], onDelete: Cascade)
  type      PhotoType @default(ALBUM)
  r2Key     String
  r2Url     String
  caption   String?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([petId, type])
}

model Share {
  id         String     @id @default(cuid())
  petId      String     @unique
  pet        Pet        @relation(fields: [petId], references: [id], onDelete: Cascade)
  slug       String     @unique
  visibility Visibility @default(LINK)
  hugEnabled Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  hugs Hug[]
}

enum Visibility {
  LINK
  PRIVATE
}

model Hug {
  id                 String   @id @default(cuid())
  shareId            String
  share              Share    @relation(fields: [shareId], references: [id], onDelete: Cascade)
  visitorFingerprint String
  visitorName        String?
  message            String?
  createdAt          DateTime @default(now())

  @@unique([shareId, visitorFingerprint])
  @@index([shareId])
}

model Letter {
  id        String   @id @default(cuid())
  petId     String
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  title     String?
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
