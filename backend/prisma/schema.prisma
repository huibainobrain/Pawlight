generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  appleUserId String   @unique
  email       String?
  nickname    String?
  avatarUrl   String?
  // Current in-app language (iOS LanguageStore, not device locale), synced
  // from iOS so Planet Life can generate event text in the right language
  // during an async background tick with no live request to read it from.
  language    String?  @default("en")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pets        Pet[]
  entitlement Entitlement?
}

model Pet {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                  String
  type                  PetType  @default(CAT)
  arrivedOn             String?
  bornOn                String?
  leftOn                String?
  mainPhotoId           String?
  story                 String?
  memorialSentence      String?
  // Observation-window scene video (V2, paid-only). Independent from
  // mainPhotoId so the static photo always stays available as a fallback —
  // null observationVideoUrl means "show the static main photo".
  observationVideoJobId String?
  observationVideoKey   String?
  observationVideoUrl   String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  photos            Photo[]
  share             Share?
  letters           Letter[]
  scenePortraitJobs ScenePortraitJob[]
  planetLifeState   PlanetLifeState?
  planetEvents      PlanetEvent[]
  giftInstances     GiftInstance[]
  homeProfile       HomeProfile?
}

enum PetType {
  CAT
  DOG
  OTHER
}

// Entitlement is account-level (one per User), not per-pet.
model Entitlement {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier            Tier     @default(FREE)
  photoLimit      Int      @default(9)
  mailboxEnabled  Boolean  @default(false)
  // Independent capability flag (mirrors mailboxEnabled): today always set
  // alongside tier=PAID, but kept separate so "can Planet Life still
  // generate new events" can later diverge from the base paid tier (e.g. a
  // future dedicated subscription) without touching every read site.
  starLifeEnabled Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum Tier {
  FREE
  PAID
}

enum PhotoType {
  MAIN
  ALBUM
}

model Photo {
  id        String    @id @default(cuid())
  petId     String
  pet       Pet       @relation(fields: [petId], references: [id], onDelete: Cascade)
  type      PhotoType @default(ALBUM)
  r2Key     String
  r2Url     String
  caption   String?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([petId, type])
}

enum ScenePortraitJobStatus {
  QUEUED
  GENERATING_IMAGE
  CANDIDATES_READY
  GENERATING_VIDEO
  DONE
  FAILED
}

// One "describe a scene -> pick a candidate -> get a looping video" attempt.
model ScenePortraitJob {
  id                  String                 @id @default(cuid())
  petId               String
  pet                 Pet                    @relation(fields: [petId], references: [id], onDelete: Cascade)
  sceneText           String
  status              ScenePortraitJobStatus @default(QUEUED)
  selectedCandidateId String?
  videoR2Key          String?
  videoR2Url          String?
  errorCode           String?
  errorMessage        String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  candidates ScenePortraitCandidate[]

  @@index([petId, createdAt])
}

model ScenePortraitCandidate {
  id        String           @id @default(cuid())
  jobId     String
  job       ScenePortraitJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  r2Key     String
  r2Url     String
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())

  @@index([jobId])
}

model Share {
  id         String     @id @default(cuid())
  petId      String     @unique
  pet        Pet        @relation(fields: [petId], references: [id], onDelete: Cascade)
  slug       String     @unique
  visibility Visibility @default(LINK)
  hugEnabled Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  hugs Hug[]
}

enum Visibility {
  LINK
  PRIVATE
}

model Hug {
  id                 String   @id @default(cuid())
  shareId            String
  share              Share    @relation(fields: [shareId], references: [id], onDelete: Cascade)
  visitorFingerprint String
  visitorName        String?
  message            String?
  createdAt          DateTime @default(now())

  @@unique([shareId, visitorFingerprint])
  @@index([shareId])
}

model Letter {
  id        String   @id @default(cuid())
  petId     String
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  title     String?
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Planet Life (星球生活): a low-frequency, pet-level async content stream,
// independent of ScenePortraitJob's on-demand generation. One PlanetLifeState
// row per Pet tracks opt-in/pause and when the next event is eligible.
// ---------------------------------------------------------------------------

model PlanetLifeState {
  id                String    @id @default(cuid())
  petId             String    @unique
  pet               Pet       @relation(fields: [petId], references: [id], onDelete: Cascade)
  enabled           Boolean   @default(false)
  paused            Boolean   @default(false)
  notifyOnNewEvent  Boolean   @default(true)
  // Set to "now + first wait" on enable, then recomputed on markRead (not on
  // publish) — the wait restarts when the user reads the unread event, per
  // product spec, not when the event was generated.
  nextEligibleAt    DateTime?
  weeklyEventCount  Int       @default(0)
  weeklyWindowStart DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

enum PlanetEventStatus {
  UNREAD
  READ
  BAD_CASE
}

// "星球来信" (unread) and "星球纪事" (read) are the same object at different
// read states — one status field, not two separate models.
model PlanetEvent {
  id                           String            @id @default(cuid())
  petId                        String
  pet                          Pet               @relation(fields: [petId], references: [id], onDelete: Cascade)
  eventTemplateKey             String
  title                        String
  body                         String
  language                     String
  imageR2Key                   String
  imageR2Url                   String
  status                       PlanetEventStatus @default(UNREAD)
  // Snapshot of the resolved facts (location/action/time/atmosphere/...)
  // actually used for this event — avoids a column per fact dimension.
  factsJson                    Json
  giftInstanceId               String?
  giftInstance                 GiftInstance?     @relation(fields: [giftInstanceId], references: [id])
  // Non-null only on the event that established (or re-established, after a
  // Bad Case invalidation) this pet's Home Anchor, carrying the version
  // number it became. This is the durable history of every anchor this pet
  // has ever had — HomeProfile itself only caches the CURRENT one for fast
  // reads; the full lineage lives here, in events that are never deleted.
  establishedHomeAnchorVersion Int?
  createdAt                    DateTime          @default(now())
  readAt                       DateTime?

  @@index([petId, createdAt])
  @@index([giftInstanceId])
}

// Human-curated, long-term-maintained fact pools a PlanetEvent is generated
// from — the system picks facts from here; AI only expresses them (never
// invents them). Seeded with one P0 test template ("小花园休息").
//
// Each *Keys field holds stable `key` values from the matching content-asset
// table below (LocationAsset / ActionAsset / ContentAsset) — never raw
// natural-language strings. A new Location/Action/Time/Atmosphere/Ambient
// Detail is "add a row and reference its key here", not "edit this template
// or any generation code". See PlanetEventGenerationService.resolveFacts for
// how these are resolved.
model EventTemplate {
  id                   String   @id @default(cuid())
  key                  String   @unique
  // Free-form human label (e.g. "daily" / "special") — purely informational,
  // not read by any selection logic. cooldownDays already provides the real
  // "rare/special event" mechanism; this just lets a human filter/scan the
  // template table by eye once there are 20-30 rows.
  category             String?
  locationKeys         Json
  actionKeys           Json
  timeKeys             Json
  atmosphereKeys       Json
  ambientDetailKeys    Json?
  giftCompatible       Boolean  @default(false)
  // Whether an event this template produces is suitable to establish (or
  // re-establish) this pet's Home Anchor. Deliberately NOT the same thing
  // as "is this template's location Home Base" — not every Home Base event
  // need make a good world-visual anchor, and this is checked together with
  // the resolved location's actual scope at generation time (see
  // PlanetEventGenerationService.pickTemplate), never trusted alone.
  homeAnchorEligible   Boolean  @default(false)
  weight               Int      @default(1)
  cooldownDays         Int?
  speciesApplicability Json?
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// HOME_BASE locations read Home Profile (and, once established, the Home
// Anchor image) at generation time; NEARBY locations only inherit Planet
// Style. Location is the single source of truth for this — EventTemplate
// deliberately does not carry a second copy of this distinction.
enum LocationScope {
  HOME_BASE
  NEARBY
}

// A Location content asset — stable key, bilingual name, and the two
// distinct descriptions PRD content-authoring needs: visualDefinition (an
// internal/narrative note so the same location stays consistent across many
// generations — not shown to users) and imageGenPrompt (the actual prompt
// fragment handed to the image-gen provider, which can reasonably diverge in
// wording from visualDefinition).
model LocationAsset {
  id                     String        @id @default(cuid())
  key                    String        @unique
  nameZh                 String
  nameEn                 String
  visualDefinition       String
  imageGenPrompt         String
  // HOME_BASE = generation reads this pet's Home Profile (and current Home
  // Anchor, once established); NEARBY = inherits Planet Style only. Default
  // NEARBY so existing rows stay unaffected until a human deliberately
  // marks one HOME_BASE.
  scope                  LocationScope @default(NEARBY)
  speciesApplicability   Json?
  // Optional: ActionAsset keys that don't make narrative sense at this
  // location (e.g. a window-sill location excludes a "digging" action).
  // Null = no restriction. Checked together with
  // ActionAsset.incompatibleLocationKeys — either side can exclude a
  // pairing — see PlanetEventGenerationService.pickAction for the
  // filter-with-fallback enforcement (a misconfigured exclusion can make a
  // pairing less likely, never blocks generation outright).
  incompatibleActionKeys Json?
  active                 Boolean       @default(true)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
}

// An Action content asset — same role as LocationAsset for EventTemplate's
// actionKeys pool.
model ActionAsset {
  id                       String   @id @default(cuid())
  key                      String   @unique
  nameZh                   String
  nameEn                   String
  visualAction             String
  speciesApplicability     Json?
  // Optional: LocationAsset keys this action doesn't make sense at. See
  // LocationAsset.incompatibleActionKeys — this is the other side of the
  // same mutual check, not a second independent mechanism.
  incompatibleLocationKeys Json?
  active                   Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

enum ContentAssetKind {
  TIME
  ATMOSPHERE
  AMBIENT_DETAIL
}

// Shared table for Time / Atmosphere / Ambient Detail content assets — the
// product spec gives all three the same minimal shape (stable key, bilingual
// expression, one stable description for the image-gen model), so one table
// with a `kind` discriminator avoids three near-identical tables. A
// template's timeKeys/atmosphereKeys/ambientDetailKeys must only reference
// rows of the matching `kind` — enforced at resolution time, not by the DB.
model ContentAsset {
  id                String           @id @default(cuid())
  key               String           @unique
  kind              ContentAssetKind
  nameZh            String
  nameEn            String
  visualDescription String
  active            Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([kind])
}

// ---------------------------------------------------------------------------
// Canonical Planet World / Home Identity. Planet Style is a global, versioned
// visual ruleset (immutable once a pet binds to a version — a future v2 must
// never retroactively change v1 pets' worlds). Home Variant Asset is the
// human-curated catalog of selectable design elements used only to
// INITIALIZE a Home Profile. Home Profile is the per-pet, long-term-stable
// result of that initialization: it freezes a resolved visual snapshot so a
// later edit to the Variant catalog can never change an existing pet's home.
// ---------------------------------------------------------------------------

// One immutable, versioned Planet Style configuration. Seeded with one P0
// test version ("pawlight_planet_v1"). `active` only controls eligibility
// for NEW Home Profile initializations — a pet already bound to a version
// keeps reading it via the FK regardless of this flag, forever.
model PlanetStyle {
  id                       String   @id @default(cuid())
  key                      String   @unique
  version                  Int      @unique
  illustrationLanguage     String
  realismLevel             String
  colorSaturationDirection String
  lighting                 String
  materialFeel             String
  worldSafetyRules         String
  forbiddenWorldStyles     String
  // The human-synthesized paragraph actually handed to the image-gen
  // provider — distinct from the structured rule fields above for the same
  // reason LocationAsset splits visualDefinition from imageGenPrompt.
  imageGenGuidance         String
  active                   Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  homeProfiles HomeProfile[]
}

enum HomeVariantKind {
  COTTAGE_BLUEPRINT
  PALETTE
  ROOF
  DOOR
  WINDOW
  SIGNATURE_PLANT
}

// Human-curated catalog a Home Profile is initialized FROM — "material to
// build a world with," never read again after that one initialization. Six
// kinds share this one table (kind-discriminated, same reasoning as
// ContentAsset) since avoiding six near-identical tables for simple catalog
// rows is worth more than per-kind type safety here.
model HomeVariantAsset {
  id               String          @id @default(cuid())
  key              String          @unique
  kind             HomeVariantKind
  nameZh           String
  nameEn           String
  visualDefinition String
  imageGenPrompt   String
  // Only meaningful for kind = PALETTE: a pure prompt string isn't precise
  // enough for a future non-AI-rendered consumer (e.g. a small UI icon).
  // Null for every other kind.
  colorTokens      Json?
  active           Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([kind])
}

enum HomeAnchorStatus {
  NONE // never established yet
  ESTABLISHED // currently has a valid, current anchor image
  INVALIDATED // had one, its event was marked Bad Case — needs re-establishing
}

// Per-pet, long-term-stable result of Home initialization — "what this
// pet's world was actually resolved to," never recomputed from the Variant
// catalog after creation. One row per Pet, created once on first enable
// (PlanetLifeService.enable -> HomeProfileService.initializeIfNeeded) and
// never re-rolled afterward.
model HomeProfile {
  id    String @id @default(cuid())
  petId String @unique
  pet   Pet    @relation(fields: [petId], references: [id], onDelete: Cascade)

  planetStyleId String
  // No onDelete here (defaults to RESTRICT) — deliberately: a PlanetStyle
  // row must never be deletable while any pet is still pinned to it, since
  // that pin is meant to last forever.
  planetStyle   PlanetStyle @relation(fields: [planetStyleId], references: [id])

  // The Variant keys actually selected at init — kept for traceability /
  // debugging only. The actual visual content a generation reads is
  // visualSnapshot below, never a live lookup through these keys, so a
  // later edit to HomeVariantAsset can never change an existing pet's home.
  cottageBlueprintKey String
  paletteKey          String
  roofKey             String
  doorKey             String
  windowKey           String
  signaturePlantKey   String
  nameplateText       String

  // Frozen, resolved description of this pet's home (cottage/palette/roof/
  // door/window/signature plant + nameplate, plus a synthesized summary
  // prompt) — see home-profile.types.ts for the shape. The fact source every
  // Home-scoped generation reads from.
  visualSnapshot Json

  homeAnchorStatus     HomeAnchorStatus @default(NONE)
  // How many anchors this pet has EVER validly had (0 = none yet). Only
  // increments when a NEW anchor is established — invalidation does not
  // decrement it, so it also doubles as "which version are we currently on
  // or waiting to replace."
  homeAnchorVersion    Int              @default(0)
  homeAnchorImageR2Key String?
  homeAnchorImageR2Url String?
  // The PlanetEvent that established the CURRENT anchor — null whenever
  // status is NONE or INVALIDATED. Full historical lineage (including past,
  // since-invalidated anchors) lives on PlanetEvent.establishedHomeAnchorVersion
  // instead, since events are never deleted and this field is overwritten.
  homeAnchorEventId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum GiftSaleStatus {
  ACTIVE
  HIDDEN
}

// A gift TYPE (e.g. "小球"). Deliberately has no price field — price comes
// from GiftProduct's StoreKit mapping, never hardcoded here.
model GiftAsset {
  id                    String         @id @default(cuid())
  key                   String         @unique
  nameZh                String
  nameEn                String
  descriptionZh         String
  descriptionEn         String
  illustrationAssetName String
  // Free-form human label (e.g. "toy" / "comfort" / "decoration") — purely
  // informational, not read by any selection logic today. Reserved for
  // future grouping/filtering once there are several gifts.
  category              String?
  // Which EventTemplate.key values this gift may appear in. Checked for
  // real in the generation pipeline (PlanetEventGenerationService) — see
  // that file's header comment for why this must be read, not just stored.
  eventCompatibility    Json
  // Optional finer restriction: which specific EventTemplate.actionPool
  // entries this gift makes narrative sense with, across any template it's
  // otherwise compatible with. Null = no restriction (any action in a
  // compatible template is fine) — this is the default and what the one
  // current test gift ("ball") uses.
  actionCompatibility   Json?
  repeatable            Boolean        @default(true)
  saleStatus            GiftSaleStatus @default(ACTIVE)
  displayOrder          Int            @default(0)
  speciesApplicability  Json?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  products  GiftProduct[]
  instances GiftInstance[]
}

// Maps a GiftAsset to a real storefront product id. iOS reads the live
// localized price from StoreKit via this productId — price is never stored
// here or on GiftAsset.
model GiftProduct {
  id          String    @id @default(cuid())
  giftAssetId String
  giftAsset   GiftAsset @relation(fields: [giftAssetId], references: [id], onDelete: Cascade)
  platform    String
  productId   String    @unique
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([giftAssetId])
}

enum GiftInstanceStatus {
  PENDING
  COMPLETED
}

// One real purchase = one independent gift instance (never a permanent
// "owns this gift type" flag). The same GiftAsset can produce many
// GiftInstances over time, each tracked separately.
model GiftInstance {
  id                    String             @id @default(cuid())
  petId                 String
  pet                   Pet                @relation(fields: [petId], references: [id], onDelete: Cascade)
  giftAssetId           String
  giftAsset             GiftAsset          @relation(fields: [giftAssetId], references: [id])
  status                GiftInstanceStatus @default(PENDING)
  // Apple transaction id, guarded unique to make purchase verification
  // idempotent against retries/duplicate client submissions.
  purchaseTransactionId String?            @unique
  purchasedAt           DateTime           @default(now())
  completedAt           DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  // Every PlanetEvent that has ever carried this instance (across retries
  // and bad-case resets) — the "current" one is whichever isn't BAD_CASE.
  events PlanetEvent[]

  @@index([petId, status])
}
